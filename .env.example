# Copia este archivo como .env y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). Usa SOLO la clave pública "anon" / "publishable".
# La clave service_role / secret NUNCA debe ir aquí ni en ningún archivo del repositorio.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
